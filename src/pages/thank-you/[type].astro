---
/**
 * Offer-specific thank-you pages (noindex). Use the URL as a backup conversion
 * goal (e.g. Meta custom conversion "URL contains /thank-you/home-value/"), but
 * count each lead only once — see README → "Ads & tracking".
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { agent, promises } from '../../config/site';
import { rich } from '../../lib/text';

const pages = {
  'home-value': {
    title: 'Your home value request is in.',
    body: `${agent.firstName} is preparing your personalized market analysis and will reach out ${promises.valuationTurnaround}. Want to talk sooner — or schedule a walkthrough for an even more accurate number?`,
    next: { label: 'Explore the selling plan', href: '/sell/' },
  },
  buyer: {
    title: 'Your listing alerts are on the way.',
    body: `${agent.firstName} will personally set up your MLS search and may reach out with a quick question or two to fine-tune it.`,
    next: { label: 'Explore communities', href: '/communities/' },
  },
  guide: {
    title: 'Check your inbox.',
    body: `Your guide is on its way. Questions while you read? ${agent.firstName} is happy to help — no pressure, ever.`,
    next: { label: 'Back to the homepage', href: '/' },
  },
  'market-report': {
    title: 'You’re subscribed.',
    body: 'Look for your first Central Ohio market update soon. You can unsubscribe anytime.',
    next: { label: 'What’s my home worth?', href: '/home-value/' },
  },
  contact: {
    title: 'Message received.',
    body: `Thanks for reaching out — ${agent.firstName} replies ${promises.responseTime}.`,
    next: { label: 'Read client reviews', href: '/reviews/' },
  },
} as const;

export function getStaticPaths() {
  return ['home-value', 'buyer', 'guide', 'market-report', 'contact'].map((type) => ({ params: { type } }));
}
const type = Astro.params.type as keyof typeof pages;
const p = pages[type];
---
<Base title="Thank you" noindex mobileCta={false}>
  <section class="relative overflow-hidden py-20 sm:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full border border-gold/20"></div>
    <div class="container-x relative max-w-2xl text-center">
      <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-navy text-gold-light"><Icon name="check" size={28} strokeWidth={2.25} /></span>
      <p data-first-name hidden class="mt-8 text-sm font-semibold uppercase tracking-[0.2em] text-gold-ink"></p>
      <h1 class="mt-4 text-[clamp(2.4rem,5vw,3.8rem)] text-navy">{p.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">{p.body}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        {agent.bookingUrl && <a href={agent.bookingUrl} target="_blank" rel="noopener" data-track="booking" data-track-location={`thank_you_${type}`} class="btn btn-primary"><Icon name="calendar" size={18} /> Book a 15-minute call</a>}
        <a href={`tel:${agent.phoneE164}`} data-track-location={`thank_you_${type}`} class:list={['btn', agent.bookingUrl ? 'btn-outline' : 'btn-primary']}><Icon name="phone" size={18} /> Call <span set:html={rich(agent.phoneDisplay)} /></a>
        <a href={`sms:${agent.smsE164}`} data-track-location={`thank_you_${type}`} class="btn btn-outline"><Icon name="message" size={18} /> Text {agent.firstName}</a>
      </div>
      <p class="mt-10"><a href={p.next.href} class="link-underline font-semibold text-navy">{p.next.label} →</a></p>
    </div>
  </section>
  <script is:inline define:vars={{ type }}>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lead_thank_you_view', lead_type: type });
    try {
      var lead = JSON.parse(sessionStorage.getItem('ss_last_lead') || 'null');
      var el = document.querySelector('[data-first-name]');
      var n = lead && lead.firstName ? lead.firstName.replace(/[^\p{L}\p{M}' -]/gu, '').slice(0, 30) : '';
      if (n && el) { el.textContent = 'Thank you, ' + n; el.hidden = false; }
    } catch (e) {}
  </script>
</Base>
