---
/**
 * Meta / Google ad landing page — seller lead magnet.
 * Copy is Special Ad Category (Housing) & Fair Housing safe: it qualifies by
 * geography and intent, never by who the visitor is.
 * Suggested ad URL: /lp/home-value/?utm_source=facebook&utm_medium=paid_social&utm_campaign=seller_home_value
 */
import Landing from '../../layouts/Landing.astro';
import Portrait from '../../components/Portrait.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import HomeValueForm from '../../components/forms/HomeValueForm.astro';
import { agent, brokerage, promises } from '../../config/site';
import { rich } from '../../lib/text';
---
<Landing title="Free Home Value Report — Westerville & Central Ohio" description={`Find out what your Westerville-area home is worth in today's market. Free personalized analysis from ${agent.name}.`} primaryLabel="Get my value">
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-48 -top-48 h-[36rem] w-[36rem] rounded-full border border-gold/20"></div>
    <div class="container-x relative grid items-start gap-x-16 gap-y-8 py-8 sm:py-14 lg:grid-cols-[1.05fr_0.95fr] lg:grid-rows-[auto_1fr] lg:py-16">
      <div class="lg:pt-6">
        <p class="eyebrow">Westerville &amp; Central Ohio homeowners</p>
        <h1 class="mt-4 text-[clamp(2.4rem,5.4vw,4.2rem)] text-navy">What’s your home worth in today’s market?</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">Get a free, personalized home value report — prepared by a local agent, not an algorithm — {promises.valuationTurnaround}.</p>
      </div>
      <div id="form" class="card scroll-mt-6 p-6 sm:p-9 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <HomeValueForm idPrefix="lp-hv" variant="lp-home-value" headingLevel="h2" />
      </div>
      <ul class="space-y-3 lg:col-start-1 lg:row-start-2">
          {[
            'Based on real nearby sales and current competition',
            'Accounts for your updates, condition and location',
            'Includes a recommended price range and estimated net proceeds',
            'Free, private and no obligation to sell',
          ].map((b) => (
            <li class="flex gap-3"><span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy text-gold-light"><Icon name="check" size={14} strokeWidth={2.5} /></span><span>{b}</span></li>
          ))}
      </ul>
    </div>
  </section>

  <section class="border-y border-line bg-white/60 py-16 sm:py-20">
    <div class="container-x grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-14">
      <div class="mx-auto w-48 sm:w-56"><Portrait sizes="224px" /></div>
      <div>
        <p class="eyebrow">Your local expert</p>
        <h2 class="mt-3 text-[clamp(2rem,4vw,2.9rem)] text-navy">{agent.name}</h2>
        <p class="font-display text-[clamp(2rem,4vw,2.9rem)] font-semibold leading-tight text-navy" set:html={rich(brokerage.name)} />
        <p class="mt-4 max-w-2xl text-lg text-muted" set:html={rich(agent.shortBio)} />
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-x">
      <h2 class="text-center text-[clamp(2rem,4vw,2.9rem)] text-navy">What homeowners say</h2>
      <div class="mt-10"><Testimonials ids={['shukria', 'dana', 'muzaffar']} showLink={false} /></div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="container-x max-w-3xl">
      <FAQ items={[
        { q: 'Is this an automated estimate?', a: `No. ${agent.firstName} personally reviews recent sales, current listings and your home’s details to prepare a real market analysis.` },
        { q: 'Do I have to sell?', a: 'Not at all. Many homeowners request a value to plan ahead, refinance, or simply stay informed. There’s no obligation.' },
        { q: 'Who sees my information?', a: `Only ${agent.firstName}. Your information is never sold, and you can opt out of contact anytime.` },
      ]} />
      <div class="mt-10 text-center"><a href="#form" class="btn btn-primary">Get my free home value</a></div>
    </div>
  </section>
</Landing>
