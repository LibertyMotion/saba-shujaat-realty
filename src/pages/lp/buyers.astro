---
/**
 * Meta / Google ad landing page — buyer listing alerts.
 * Suggested ad URL: /lp/buyers/?utm_source=facebook&utm_medium=paid_social&utm_campaign=buyer_alerts
 */
import Landing from '../../layouts/Landing.astro';
import Portrait from '../../components/Portrait.astro';
import Testimonials from '../../components/Testimonials.astro';
import Icon from '../../components/Icon.astro';
import BuyerForm from '../../components/forms/BuyerForm.astro';
import { agent, brokerage } from '../../config/site';
import { rich } from '../../lib/text';
---
<Landing title="New Westerville-Area Listings, Sent to You" description={`Get new homes for sale in Westerville and nearby Central Ohio communities sent straight from the MLS by ${agent.name}.`} primaryLabel="Get listings">
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -right-48 -top-48 h-[36rem] w-[36rem] rounded-full border border-gold/20"></div>
    <div class="container-x relative grid items-start gap-x-16 gap-y-8 py-8 sm:py-14 lg:grid-cols-[1.05fr_0.95fr] lg:grid-rows-[auto_1fr] lg:py-16">
      <div class="lg:pt-6">
        <p class="eyebrow">Shopping for a home in Central Ohio?</p>
        <h1 class="mt-4 text-[clamp(2.4rem,5.4vw,4.2rem)] text-navy">See new listings the moment they hit the market.</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">Tell {agent.firstName} what you’re looking for. You’ll get a custom search straight from the Columbus MLS, covering Westerville, Lewis Center, Powell, New Albany and nearby communities.</p>
      </div>
      <div id="form" class="card scroll-mt-6 p-6 sm:p-9 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <BuyerForm idPrefix="lp-buy" variant="lp-buyers" headingLevel="h2" />
      </div>
      <ul class="space-y-3 lg:col-start-1 lg:row-start-2">
          {[
            'Accurate, real-time MLS data — no stale listings',
            'Only homes that match your price, size and areas',
            'A local expert to answer questions when you’re ready',
          ].map((b) => (
            <li class="flex gap-3"><span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-navy text-gold-light"><Icon name="check" size={14} strokeWidth={2.5} /></span><span>{b}</span></li>
          ))}
      </ul>
    </div>
  </section>

  <section class="border-y border-line bg-white/60 py-16 sm:py-20">
    <div class="container-x grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-14">
      <div class="mx-auto w-48 sm:w-56"><Portrait sizes="224px" /></div>
      <div>
        <p class="eyebrow">Your local guide</p>
        <h2 class="mt-3 text-[clamp(2rem,4vw,2.9rem)] text-navy">{agent.name}</h2>
        <p class="font-display text-[clamp(2rem,4vw,2.9rem)] font-semibold leading-tight text-navy" set:html={rich(brokerage.name)} />
        <p class="mt-4 max-w-2xl text-lg text-muted" set:html={rich(agent.shortBio)} />
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-x">
      <h2 class="text-center text-[clamp(2rem,4vw,2.9rem)] text-navy">What buyers say</h2>
      <div class="mt-10"><Testimonials ids={['waqas', 'delaware', 'fatou']} showLink={false} /></div>
      <div class="mt-12 text-center"><a href="#form" class="btn btn-primary">Start my listing alerts</a></div>
    </div>
  </section>
</Landing>
