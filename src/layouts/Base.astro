---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { agent, brokerage, site } from '../config/site';
import { communities } from '../data/communities';
import { plain } from '../lib/text';
import Tracking from '../components/Tracking.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTA from '../components/MobileCTA.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** 'site' = full header/footer; 'landing' = ad landing chrome (set by Landing layout) */
  chrome?: 'site' | 'none';
  mobileCta?: { primaryHref?: string; primaryLabel?: string } | false;
}
const {
  title,
  description = site.defaultDescription,
  ogImage = site.ogImage,
  noindex = false,
  schema = [],
  chrome = 'site',
  mobileCta = {},
} = Astro.props;

const fullTitle = plain(title ? `${title} | ${agent.name}` : site.defaultTitle);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(basePath + ogImage, Astro.site).href;
const origin = new URL(basePath + '/', Astro.site).href;
// Preview builds (e.g. GitHub Pages before launch): banner, noindex everywhere, forms don't send.
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';

const sameAs = Object.values(agent.social).filter(Boolean);
const agentSchema = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${origin}#agent`,
  name: agent.name,
  url: origin,
  image: ogUrl,
  telephone: agent.phoneE164,
  email: plain(agent.email),
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: plain(brokerage.street),
    addressLocality: brokerage.city,
    addressRegion: brokerage.region,
    postalCode: plain(brokerage.postalCode),
    addressCountry: 'US',
  },
  areaServed: communities.map((c) => ({ '@type': 'City', name: `${c.name}, OH` })),
  parentOrganization: { '@type': 'RealEstateAgent', name: plain(brokerage.name), telephone: brokerage.phoneE164 },
  knowsLanguage: agent.languages.length ? agent.languages : undefined,
  sameAs,
};
const graph = [agentSchema, ...schema];
---
<!doctype html>
<html lang="en" data-preview={preview ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={plain(description)} />
    <link rel="canonical" href={canonical} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1b2a41" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={plain(description)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <Tracking />
    <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />
  </head>
  <body class="min-h-dvh pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0">
    {preview && (
      <div role="note" class="relative z-[60] bg-gold-light px-4 py-2 text-center text-xs font-semibold text-navy-deep sm:text-sm">
        Preview site — not yet live. Forms are not connected, so nothing you submit is sent.
      </div>
    )}
    {chrome === 'site' && <Header />}
    <slot name="header" />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    {chrome === 'site' && <Footer />}
    <slot name="footer" />
    {mobileCta !== false && <MobileCTA {...mobileCta} />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
