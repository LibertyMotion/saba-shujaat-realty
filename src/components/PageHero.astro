---
/** Interior page header with breadcrumb. */
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden border-b border-line bg-ivory-deep/60">
  <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full border border-gold/25"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-[20rem] w-[20rem] rounded-full border border-gold/20"></div>
  <div class="container-x relative py-14 sm:py-20">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-navy">Home</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-gold">/</span>
              {c.href ? <a href={c.href} class="hover:text-navy">{c.label}</a> : <span aria-current="page" class="text-navy">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-4 max-w-4xl text-[clamp(2.5rem,5.5vw,4.5rem)] text-navy">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{lead}</p>}
    <slot />
  </div>
</section>
