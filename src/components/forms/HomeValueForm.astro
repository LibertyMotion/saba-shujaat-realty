---
/** Two-step home valuation form: address first (easy commitment), then contact. */
import { agent } from '../../config/site';
import LeadForm from './LeadForm.astro';
import Field from './Field.astro';
import ChoiceGroup from './ChoiceGroup.astro';
import Consent from './Consent.astro';
import Icon from '../Icon.astro';

interface Props { idPrefix: string; variant?: string; successUrl?: string; class?: string; submitLabel?: string; headingLevel?: 'h2' | 'h3' }
const { idPrefix, variant = 'site', successUrl = '/thank-you/home-value/', class: className = '', submitLabel = 'Get my home value' } = Astro.props;
const H = Astro.props.headingLevel ?? 'h3';
const PHONE = '^(\\+?1[\\s.\\-]?)?\\(?\\d{3}\\)?[\\s.\\-]?\\d{3}[\\s.\\-]?\\d{4}$';
---
<LeadForm name="home-value" leadType="home-value" successUrl={successUrl} variant={variant} class={className}>
  <div class="mb-5 flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-ink" data-step-progress aria-live="polite">Step 1 of 2</p>
    <p class="flex items-center gap-1.5 text-xs text-muted"><Icon name="lock" size={14} /> Free · No obligation</p>
  </div>

  <div data-step>
    <H data-step-heading tabindex="-1" class="font-display text-2xl text-navy outline-none sm:text-[1.7rem]">What’s the property address?</H>
    <p class="mt-1 text-sm text-muted">{agent.firstName} will prepare a personalized market analysis — not an automated guess.</p>
    <Field id={`${idPrefix}-address`} name="property_address" label="Street address, city" required autocomplete="street-address" placeholder="123 Main St, Westerville" prefill="address" class="mt-5" minlength={5} />
    <button type="button" data-next class="btn btn-primary mt-5 w-full">
      Continue <Icon name="arrowRight" size={18} />
    </button>
  </div>

  <div data-step hidden>
    <H data-step-heading tabindex="-1" class="font-display text-2xl text-navy outline-none sm:text-[1.7rem]">Where should {agent.firstName} send your report?</H>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <Field id={`${idPrefix}-name`} name="name" label="Full name" required autocomplete="name" class="sm:col-span-2" minlength={2} />
      <Field id={`${idPrefix}-email`} name="email" type="email" label="Email" required autocomplete="email" inputmode="email" />
      <Field id={`${idPrefix}-phone`} name="phone" type="tel" label="Phone" required autocomplete="tel" inputmode="tel" pattern={PHONE} />
      <div class="sm:col-span-2">
        <ChoiceGroup
          idPrefix={idPrefix}
          name="timeline"
          legend="When might you sell? (optional)"
          cols={4}
          options={[
            { value: '0-3 months', label: '0–3 mo' },
            { value: '3-6 months', label: '3–6 mo' },
            { value: '6-12 months', label: '6–12 mo' },
            { value: 'just curious', label: 'Just curious' },
          ]}
        />
      </div>
      <div class="sm:col-span-2"><Consent idPrefix={idPrefix} /></div>
    </div>
    <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row">
      <button type="button" data-back class="btn btn-outline sm:w-auto"><Icon name="arrowLeft" size={18} /> Back</button>
      <button type="submit" class="btn btn-primary flex-1">{submitLabel}</button>
    </div>
  </div>
</LeadForm>
