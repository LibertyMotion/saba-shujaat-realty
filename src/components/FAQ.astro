---
/** Accessible FAQ using native <details>. Pass the same items to FAQPage schema if desired. */
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-line rounded-[var(--radius-card)] border border-line bg-white">
  {items.map((item) => (
    <details class="group p-0 [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-left font-semibold text-navy transition hover:bg-ivory/60 sm:px-8">
        <span class="text-[1.05rem]">{item.q}</span>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-gold-ink transition group-open:rotate-180 group-open:bg-navy group-open:text-ivory">
          <Icon name="chevronDown" size={18} />
        </span>
      </summary>
      <div class="px-6 pb-6 text-muted sm:px-8"><p>{item.a}</p></div>
    </details>
  ))}
</div>
