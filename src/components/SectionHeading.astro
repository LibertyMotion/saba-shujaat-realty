---
interface Props { eyebrow?: string; title: string; lead?: string; align?: 'left' | 'center'; as?: 'h1' | 'h2'; class?: string }
const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', class: className = '' } = Astro.props;
---
<div class:list={[align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl', className]} data-reveal>
  {eyebrow && <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>}
  <Tag class="mt-4 text-[clamp(2.1rem,4.2vw,3.4rem)] text-navy [.on-dark_&]:text-ivory">{title}</Tag>
  {lead && <p class="mt-5 text-lg leading-relaxed text-muted [.on-dark_&]:text-ivory/75">{lead}</p>}
  <slot />
</div>
