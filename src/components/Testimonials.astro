---
/**
 * Verbatim Zillow reviews with date, transaction line and a link back to the
 * source. Long reviews are clamped (JS only) with a "Read full review" toggle —
 * the full, unedited text is always in the page.
 */
import { agent } from '../config/site';
import { pickTestimonials, formatReviewDate } from '../data/testimonials';
import Icon from './Icon.astro';
interface Props { ids?: string[]; limit?: number; showLink?: boolean; layout?: 'grid' | 'masonry'; clamp?: boolean }
const { ids, limit = 3, showLink = true, layout = 'grid', clamp = true } = Astro.props;
const items = pickTestimonials(ids).slice(0, ids ? ids.length : limit);
const LONG = clamp ? 600 : Infinity; // only the very long reviews get a toggle
---
<div>
  <ul class:list={[layout === 'grid' ? 'grid items-start gap-6 md:grid-cols-3' : 'gap-6 md:columns-2 lg:columns-3 [&>li]:mb-6 [&>li]:break-inside-avoid']}>
    {items.map((t, i) => (
      <li class="card flex flex-col p-7 sm:p-8" data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
        <div class="mb-5 flex items-center justify-between gap-3">
          <div class="flex gap-1 text-gold" aria-label={`Rated ${t.rating} out of 5 on ${t.source}`} role="img">
            {Array.from({ length: t.rating }).map(() => <Icon name="star" size={16} class="fill-current" />)}
          </div>
          <time datetime={t.date} class="text-xs text-muted">{formatReviewDate(t.date)}</time>
        </div>
        <blockquote
          class:list={[
            'font-display leading-snug text-navy',
            t.quote.length > LONG ? 'text-[1.12rem] [.js_&]:line-clamp-[9] [.js_&.is-expanded]:line-clamp-none' : 'text-[1.25rem]',
          ]}
          id={`review-${t.id}-${i}`}
          cite={t.sourceUrl}
        >
          {t.quote}
        </blockquote>
        {t.quote.length > LONG && (
          <button
            type="button"
            data-review-toggle
            aria-expanded="false"
            aria-controls={`review-${t.id}-${i}`}
            class="mt-3 hidden cursor-pointer self-start text-sm font-semibold text-navy underline decoration-gold/60 underline-offset-4 hover:decoration-gold [.js_&]:inline"
          >
            Read full review
          </button>
        )}
        {t.reply && (
          <p class="mt-4 rounded-xl bg-ivory-deep/70 p-3 text-sm text-muted"><strong class="text-navy">{agent.firstName}’s reply:</strong> {t.reply}</p>
        )}
        <div class="mt-6 border-t border-line pt-4 text-sm">
          <p class="font-semibold text-navy">{t.name}</p>
          <p class="text-muted">{t.context}</p>
          <a href={t.sourceUrl} target="_blank" rel="noopener" class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-gold-ink hover:text-navy">
            View this review on {t.source} <Icon name="external" size={12} />
          </a>
        </div>
      </li>
    ))}
  </ul>
  {showLink && (
    <p class="mt-8 text-center">
      <a href={agent.social.zillow} target="_blank" rel="noopener" class="link-underline inline-flex items-center gap-2 font-semibold text-navy">
        Read all of {agent.firstName}’s reviews on Zillow <Icon name="external" size={16} />
      </a>
    </p>
  )}
</div>
