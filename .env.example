# Copy to .env (local) or set in your host's dashboard (Netlify → Site settings → Environment variables).

# Required before launch: the live domain (drives canonical URLs, sitemap, Open Graph)
SITE_URL=https://www.yourdomain.com

# --- Lead forms ---
# Leave empty to use Netlify Forms (zero setup on Netlify).
# Or set to any endpoint that accepts a multipart POST: Formspree, a CRM webhook
# (Follow Up Boss, BoldTrail/kvCORE, Lofty via Zapier/Make), etc.
PUBLIC_FORM_ENDPOINT=

# --- Tracking (recommended: GTM only, configure GA4 / Google Ads / Meta inside GTM) ---
PUBLIC_GTM_ID=
# Direct (no-GTM) alternatives — don't combine with the same tags inside GTM:
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
